<Window x:Class="RadeonPatcher.AdvancedPatchesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Advanced Driver Patches" Height="720" Width="650"
        MinHeight="560" MinWidth="560" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Advanced Driver Patches"/>
            <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                       Text="These experimental options modify AMD driver packages or driver registry values. Defaults preserve AMD behavior."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <CheckBox x:Name="EnablePatchesCheck" Content="Enable advanced patches" FontWeight="SemiBold"
                                  Checked="EnablePatchesCheck_Changed" Unchecked="EnablePatchesCheck_Changed"/>
                        <TextBlock Margin="26,6,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                                   Text="Package changes are locally cataloged and signed using RadeonPatcher’s machine certificate."/>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="OptionsPanel">
                    <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="INF package patches"/>
                            <CheckBox x:Name="DisableAnalyticsCheck" Margin="0,12,0,0"
                                      Content="Disable AMD analytics, reports, and driver update prompts"/>
                            <CheckBox x:Name="FeatureOverridesCheck" Margin="0,10,0,0"
                                      Content="Expose Radeon upscaling, video upscale, Anti-Lag, and frame generation flags"/>
                            <CheckBox x:Name="LegacyRebarInfCheck" Margin="0,10,0,0"
                                      Content="Expose legacy ASIC Resizable BAR support"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Binary-only Radeon-ID feature inventory"/>
                            <TextBlock Margin="0,6,0,10" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                                       Text="Visible for coverage tracking. These cannot be recreated safely from the published distribution because their source or redistributable payload is missing."/>
                            <TextBlock FontWeight="SemiBold" Text="Radeon Software archive switching and ReLive DVR/VR add-ons"/>
                            <TextBlock Margin="0,2,0,8" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                                       Text="Requires historical AMD UI and ReLive packages. Latest Adrenalin installation remains available in the main window."/>
                            <TextBlock FontWeight="SemiBold" Text="Crash Defender, RDNA2 USB LED, Ryzen Master SDK, and mobile PCI bridge"/>
                            <TextBlock Margin="0,2,0,8" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                                       Text="Requires Radeon-ID-bundled drivers, services, or MSI payloads; no source was published."/>
                            <TextBlock FontWeight="SemiBold" Text="OEM Media Foundation codecs and K-Lite integration"/>
                            <TextBlock Margin="0,2,0,8" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                                       Text="Requires third-party AppX and codec packages unrelated to AMD display-driver patching."/>
                            <TextBlock FontWeight="SemiBold" Text="Proxy display miniport, Radeon-ID driver modes, and WHQL anti-cheat workaround"/>
                            <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                                       Text="Requires unpublished kernel components. RadeonPatcher will not copy opaque signed drivers from the distribution."/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Runtime driver overrides"/>
                            <TextBlock Margin="0,6,0,12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                                       Text="Apply during driver installation or immediately to installed AMD adapters. Default removes RadeonPatcher overrides."/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="220"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="Resizable BAR"/>
                                <ComboBox x:Name="RebarCombo" Grid.Column="1" MinHeight="32">
                                    <ComboBoxItem Content="AMD default"/>
                                    <ComboBoxItem Content="Disabled"/>
                                    <ComboBoxItem Content="Enabled"/>
                                    <ComboBoxItem Content="Forced for legacy ASIC"/>
                                </ComboBox>
                                <TextBlock Grid.Row="1" Margin="0,10,0,0" VerticalAlignment="Center" Text="Hardware GPU scheduling"/>
                                <ComboBox x:Name="HardwareSchedulingCombo" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" MinHeight="32">
                                    <ComboBoxItem Content="Windows/AMD default"/>
                                    <ComboBoxItem Content="Disabled"/>
                                    <ComboBoxItem Content="Enabled"/>
                                </ComboBox>
                                <TextBlock Grid.Row="2" Margin="0,10,0,0" VerticalAlignment="Center" Text="Hardware flip queue"/>
                                <ComboBox x:Name="HardwareFlipCombo" Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" MinHeight="32">
                                    <ComboBoxItem Content="AMD default"/>
                                    <ComboBoxItem Content="Disabled"/>
                                    <ComboBoxItem Content="Mode 1"/>
                                    <ComboBoxItem Content="Mode 2"/>
                                </ComboBox>
                                <TextBlock Grid.Row="3" Margin="0,10,0,0" VerticalAlignment="Center" Text="Shader cache"/>
                                <ComboBox x:Name="ShaderCacheCombo" Grid.Row="3" Grid.Column="1" Margin="0,10,0,0" MinHeight="32">
                                    <ComboBoxItem Content="AMD default"/>
                                    <ComboBoxItem Content="Disabled"/>
                                    <ComboBoxItem Content="Forced enabled"/>
                                </ComboBox>
                                <TextBlock Grid.Row="4" Margin="0,10,0,0" VerticalAlignment="Center" Text="Windows driver updates"/>
                                <ComboBox x:Name="WindowsDriverUpdatesCombo" Grid.Row="4" Grid.Column="1" Margin="0,10,0,0" MinHeight="32">
                                    <ComboBoxItem Content="Windows default"/>
                                    <ComboBoxItem Content="Enabled"/>
                                    <ComboBoxItem Content="Only when needed"/>
                                    <ComboBoxItem Content="Partially disabled"/>
                                    <ComboBoxItem Content="Fully disabled"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Radeon-ID feature lab"/>
                            <TextBlock Margin="0,6,0,10" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                                       Text="Raw registry presets recovered from Radeon-ID Distribution 25.3.1. This exhaustive list is intentionally unpolished. Conflicting presets cannot be saved."/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PresetSearchBox" Height="30" Padding="7,3" TextChanged="PresetSearchBox_TextChanged"
                                         ToolTip="Filter by preset name, category, or registry value"/>
                                <Button Grid.Column="1" Width="110" Height="30" Margin="8,0,0,0" Content="Clear Selected" Click="ClearPresetsButton_Click"/>
                            </Grid>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock x:Name="PresetResultCountText" DockPanel.Dock="Left" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock x:Name="PresetSelectedCountText" DockPanel.Dock="Right" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </DockPanel>
                            <ListBox x:Name="RadeonIdPresetList" Height="330"
                                     Background="{DynamicResource InputBackgroundBrush}"
                                     BorderBrush="{DynamicResource InputBorderBrush}"
                                     BorderThickness="1"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="5,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Top"
                                                      Click="PresetCheckBox_Click"/>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" TextWrapping="Wrap"/>
                                                <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource SecondaryTextBrush}"
                                                           Text="{Binding Details}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel>
                            <CheckBox x:Name="HybridDriverCheck" Content="Build experimental hybrid driver" FontWeight="SemiBold"
                                      Checked="HybridDriverCheck_Changed" Unchecked="HybridDriverCheck_Changed"/>
                            <TextBlock Margin="26,6,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                                       Text="Keeps the selected legacy kernel package and overlays matching user-mode components from the latest modern AMD package. Intended for Polaris and Vega. Hardware validation is required."/>
                            <StackPanel x:Name="HybridSourcePanel" Margin="26,12,0,0">
                                <TextBlock Text="Modern AMD support page"/>
                                <TextBox x:Name="ModernSupportUrlBox" Margin="0,5,0,0" Height="30"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Width="150" Height="36" Margin="0,0,10,0" Content="Apply Runtime Now" Click="ApplyNowButton_Click"/>
            <Button Grid.Column="2" Width="90" Height="36" Margin="0,0,10,0" Content="Cancel" Click="CancelButton_Click"/>
            <Button Grid.Column="3" Width="90" Height="36" Content="Save" Style="{DynamicResource AccentDialogButtonStyle}" Click="SaveButton_Click"/>
        </Grid>
    </Grid>
</Window>
